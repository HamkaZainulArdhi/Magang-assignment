# Copy this file to .env and adjust the values for your machine.
# Never commit real secrets.

NODE_ENV=development
PORT=3000

# MySQL connection string (database: inventory)
DATABASE_URL="mysql://inventory:inventory@127.0.0.1:3307/inventory"

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="1d"

# bcrypt cost factor (10-15)
BCRYPT_ROUNDS=10
